# ─── Search Providers ────────────────────────────────────────────────────────
# DuckDuckGo is the default provider and requires no API key.

# Brave Search API (optional – enables higher rate limits and better results)
# Get your key at: https://brave.com/search/api/
BRAVE_API_KEY=

# SerpAPI (optional – Google-backed results)
# Get your key at: https://serpapi.com/
SERPAPI_KEY=

# ─── Provider Selection ───────────────────────────────────────────────────────
# Comma-separated ordered list. First available wins.
# Options: duckduckgo, brave, serpapi
SEARCH_PROVIDERS=duckduckgo,brave

# ─── Cache ────────────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=512

# ─── HTTP ─────────────────────────────────────────────────────────────────────
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=2

# ─── Fetcher ──────────────────────────────────────────────────────────────────
# Maximum number of characters returned when fetching a page
FETCH_MAX_CHARS=8000
