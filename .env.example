# ─── Search Index ─────────────────────────────────────────────────────────────
# Path to the SQLite database file. Defaults to search_index.db in the CWD.
INDEX_DB_PATH=search_index.db

# ─── Crawler ──────────────────────────────────────────────────────────────────
# Seconds to wait between requests to the same domain (be polite!)
CRAWL_DELAY_SECONDS=1.0

# Maximum number of text characters extracted per page body
MAX_BODY_CHARS=50000

# ─── HTTP ─────────────────────────────────────────────────────────────────────
HTTP_TIMEOUT_SECONDS=15

# ─── peek_document ────────────────────────────────────────────────────────────
# Maximum characters returned when peeking at a document's body
FETCH_MAX_CHARS=8000

# ─── Authentication ────────────────────────────────────────────────────────────
# Bearer token required on HTTP transports (--transport sse / streamable-http).
# Leave unset for stdio mode (Claude Desktop) — no auth needed there.
# Generate a key: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=
